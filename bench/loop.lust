-- lust-rs, the closest thing to Luarust that already exists: Lua-shaped, written in
-- Rust, with type annotations and a JIT. Which is exactly why it is in the standard set
-- rather than as a curiosity -- it is the comparison that is hardest to explain away.
local sum: int = 0
for i = 1, ITERATIONS do
    sum = (sum + i) % 1000000007
end
println(tostring(sum))
