{
  "name": "luarust",
  "displayName": "Luarust",
  "description": "Syntax highlighting and live checking for Luarust.",
  "version": "0.0.1",
  "publisher": "tankun-sriket",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:luarust",
    "onLanguage:luarust-toml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "luarust",
        "aliases": [
          "Luarust",
          "luarust"
        ],
        "extensions": [
          ".lr"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "luarust-toml",
        "aliases": [
          "Luarust project file"
        ],
        "filenames": [
          "Luarust.toml"
        ],
        "configuration": "./toml-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "luarust",
        "scopeName": "source.luarust",
        "path": "./syntaxes/luarust.tmLanguage.json"
      },
      {
        "language": "luarust-toml",
        "scopeName": "source.luarust-toml",
        "path": "./syntaxes/luarust-toml.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Luarust",
      "properties": {
        "luarust.path": {
          "type": "string",
          "default": "luarust",
          "description": "The `luarust` command. An absolute path if it is not on PATH."
        },
        "luarust.checkOn": {
          "type": "string",
          "enum": [
            "save",
            "type",
            "never"
          ],
          "default": "save",
          "description": "When to run `luarust check`. `type` checks a moment after you stop typing."
        },
        "luarust.suggest": {
          "type": "boolean",
          "default": true,
          "description": "Suggest chain words, types and the names this file declares as you type."
        }
      }
    },
    "commands": [
      {
        "command": "luarust.check",
        "title": "Luarust: Check this file"
      },
      {
        "command": "luarust.run",
        "title": "Luarust: Run this file"
      },
      {
        "command": "luarust.jit",
        "title": "Luarust: Run this file through the JIT"
      },
      {
        "command": "luarust.dis",
        "title": "Luarust: Show the bytecode"
      }
    ],
    "configurationDefaults": {
      "[luarust]": {
        "editor.wordBasedSuggestions": "off",
        "editor.suggest.showWords": false,
        "editor.inlineSuggest.enabled": false
      },
      "[luarust-toml]": {
        "editor.wordBasedSuggestions": "off",
        "editor.suggest.showWords": false,
        "editor.inlineSuggest.enabled": false
      }
    }
  }
}
